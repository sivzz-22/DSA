class Solution {
    public int getSecondLargest(int[] arr) {
        // code here
        int max = -1;
        int sec_max = -1; //GFG wants to return -1 if the both max and sec_max are same
        for(int i=1;i<arr.length;i++){
            if(arr[i]>max){
                sec_max=max;
                max=arr[i];
            }
            else if(arr[i]>sec_max && arr[i]!=max){ // arr[i]!=max -> Checking is imp...bcz (1)
                sec_max=arr[i];
            }
        }
        return sec_max;
    }
}

