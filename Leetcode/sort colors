class Solution {
    public void sortColors(int[] nums) {
        int r_count=0;
        int w_count=0;
        int b_count=0;
        
        for(int i=0;i<nums.length;i++){
            if(nums[i]==0){
                r_count +=1;
            }
            else if(nums[i]==1){
                w_count += 1;
            }
            else{
                b_count += 1;
            }
        }

        for(int x=0;x<r_count;x++){
            nums[x]=0;
        }
        for(int y=r_count;y<r_count+w_count;y++){
            nums[y]=1;
        }
        for(int z=r_count+w_count;z<nums.length;z++){
            nums[z]=2;
        }
    }
}
