class Solution {

    static void rev(int[] arr,int x,int y){
        while(x<y){
            int temp = arr[x];
            arr[x]=arr[y];
            arr[y]=temp;
            x++;
            y--;
        }
    }
    public void rotate(int[] nums, int k) {
        int i = 0 ;
        int j = nums.length-1;

        if(k>nums.length){
            k=k%nums.length;
        }

        rev(nums,0,nums.length-1);
        rev(nums,0,k-1);
        rev(nums,k,nums.length-1);
        
    }
}


